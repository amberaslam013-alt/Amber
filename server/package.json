{
  "name": "grand-hotel-server",
  "version": "1.0.0",
  "description": "Backend API for Grand Hotel Bad Pyrmont booking system",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/migrations/migrate.js",
    "migrate:watch": "nodemon --exec 'npm run migrate'",
    "seed": "node src/seeds/seedDb.js",
    "test": "jest --detectOpenHandles"
  },
  "keywords": [
    "hotel",
    "booking",
    "reservation",
    "spa",
    "wellness"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "axios": "^1.6.2",
    "stripe": "^13.9.0",
    "nodemailer": "^6.9.7",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  }
}
