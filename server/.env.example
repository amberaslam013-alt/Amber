# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grand_hotel_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@grandhotel.com
SMTP_FROM_NAME=Grand Hotel Bad Pyrmont

# Hotel Configuration
HOTEL_NAME=Grand Hotel Bad Pyrmont
HOTEL_EMAIL=reservations@grandhotel.com
HOTEL_PHONE=+49 5281 1680
HOTEL_ADDRESS=Brunnenstraße 1, 31812 Bad Pyrmont, Germany
HOTEL_WEBSITE=https://grandhotel.com

# Payment Configuration
CURRENCY=EUR
TAX_PERCENTAGE=19
PAYMENT_TIMEOUT=3600

# Admin Configuration
ADMIN_EMAIL=admin@grandhotel.com
ADMIN_PASSWORD=changeme_in_production
